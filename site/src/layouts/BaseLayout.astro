---
import type { Language } from "../loaders/bilingual-post";
import { canonicalUrl, otherLanguage } from "../lib/urls";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: Language;
  path: string;
  alternatePath: string;
  defaultPath: string;
}

const { title, description, lang, path, alternatePath, defaultPath } = Astro.props;
const site = Astro.site!.toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl(path, site)} />
    <link rel="alternate" hreflang={otherLanguage(lang)} href={canonicalUrl(alternatePath, site)} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl(defaultPath, site)} />
    <!-- Browsers ask for /favicon.ico whether or not it is declared, so the file
         exists as well as the link. The SVG is what a current browser picks. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="vulinh.dev"
      href={lang === "vi" ? "/vi/rss.xml" : "/rss.xml"}
    />
    <!-- Per-page additions to <head>. Feed autodiscovery is NOT one of them:
         the line above covers every page, so a page adding its own would ship
         the same feed twice. Pages fill this with <Fragment slot="head">. -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[var(--color-page)] text-[var(--color-ink)] antialiased">
    <div class="mx-auto max-w-3xl px-5 py-10">
      <slot />
      <footer class="mt-16 border-t border-[var(--color-rule)] pt-6 text-sm text-[var(--color-muted)]">
        <p>
          Prose licensed under <a class="underline" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          Code samples under <a class="underline" href="https://opensource.org/license/mit">MIT</a>.
        </p>
      </footer>
    </div>
  </body>
</html>
