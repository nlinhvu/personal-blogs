---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { postPath } from "../../lib/urls";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => data.lang === "en");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = postPath(entry.data.slug, "en");
const alternatePath = postPath(entry.data.slug, "vi");
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="en"
  path={path}
  alternatePath={alternatePath}
  defaultPath={path}
>
  <nav><LanguageSwitcher lang="en" href={alternatePath} /></nav>
  <article class="prose prose-lg prose-zinc dark:prose-invert max-w-none">
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.pubDate.toISOString()}>
      {entry.data.pubDate.toISOString().slice(0, 10)}
    </time>
    <Content />
  </article>
</BaseLayout>
