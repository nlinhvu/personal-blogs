---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../../components/LanguageSwitcher.astro";
import StructuredData from "../../../components/StructuredData.astro";
import { postPath, tagPath, canonicalUrl, ogImagePath } from "../../../lib/urls";
import { blogPostingSchema } from "../../../lib/schema";
import { readTagRegistry } from "../../../loaders/bilingual-post";
import { CONTENT_BASE } from "../../../lib/content-base";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => data.lang === "vi");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = postPath(entry.data.slug, "vi");
const alternatePath = postPath(entry.data.slug, "en");
const site = Astro.site!.toString();
const tagRegistry = readTagRegistry(CONTENT_BASE);
const schema = blogPostingSchema({
  title: entry.data.title,
  description: entry.data.description,
  canonical: canonicalUrl(path, site),
  imageUrl: canonicalUrl(ogImagePath(entry.data.slug, "vi"), site),
  pubDate: entry.data.pubDate,
  lang: "vi",
  tagLabels: entry.data.tags.map((tag) => tagRegistry[tag].vi),
});
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="vi"
  path={path}
  alternatePath={alternatePath}
  defaultPath={alternatePath}
  slug={entry.data.slug}
>
  <Fragment slot="head"><StructuredData schema={schema} /></Fragment>
  <nav><LanguageSwitcher lang="vi" href={alternatePath} /></nav>
  <article class="prose prose-lg prose-zinc dark:prose-invert max-w-none">
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.pubDate.toISOString()}>
      {entry.data.pubDate.toISOString().slice(0, 10)}
    </time>
    <Content />
  </article>
  <ul class="mt-8 flex gap-3 text-sm">
    {entry.data.tags.map((tag) => (
      <li>
        <a class="underline" href={tagPath(tag, "vi")}>{readTagRegistry(CONTENT_BASE)[tag].vi}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
