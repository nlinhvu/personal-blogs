---
import type { Language } from "../loaders/bilingual-post";
import { postPath } from "../lib/urls";

interface Entry {
  data: { slug: string; title: string; description: string; pubDate: Date };
}

interface Props {
  entries: Entry[];
  lang: Language;
}

const { entries, lang } = Astro.props;
---
{/*
  The one list shape the site has: the home page and every tag page render it.
  Four call sites, so it lives here rather than being copied and drifting.

  The date is the ISO day, matching the post pages. toLocaleDateString would
  read better but its output depends on the ICU data compiled into whichever
  Node the CI runner happens to have, and a build that renders differently on
  a different machine is not worth a prettier date.
*/}
<ul class="space-y-10">
  {entries.map((entry) => (
    <li>
      <time
        class="text-sm tabular-nums text-[var(--color-muted)]"
        datetime={entry.data.pubDate.toISOString()}
      >
        {entry.data.pubDate.toISOString().slice(0, 10)}
      </time>
      <h2 class="mt-1 text-xl font-semibold tracking-tight">
        <a class="underline-offset-4 hover:underline" href={postPath(entry.data.slug, lang)}>
          {entry.data.title}
        </a>
      </h2>
      <p class="mt-2 text-[var(--color-muted)]">{entry.data.description}</p>
    </li>
  ))}
</ul>
