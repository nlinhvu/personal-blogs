# Copy to terraform.tfvars and fill in, or export TF_VAR_cloudflare_account_id
# instead. terraform.tfvars is gitignored; this example file is not.
#
# Account ID of the prod Cloudflare account. Not a secret: it appears in
# dashboard URLs and CI logs. The API token is the secret.
cloudflare_account_id = "7a78eec29b31ad25b2a9f749a3cc2078"

# Optional, both have defaults.
# zone_name   = "vulinh.dev"
# worker_name = "blog-prod"
