# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# This key never leaves the author's machine. No GitHub workflow reads it, and
# nothing in CI translates: a translation is written locally, reviewed by a
# human, and committed like any other change.
GEMINI_API_KEY=

# Optional. Leave unset to use the script's default.
# Model names change; if a run fails with "model not found" the script prints
# the models this key can actually reach, and one of those goes here.
GEMINI_MODEL=
